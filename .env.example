# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=parliament_search
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Google AI Configuration (dormant for live app — kept for KG extraction scripts)
GOOGLE_API_KEY=your-google-api-key-here

# Embeddings
# Default provider is local_bge (sentence-transformers, runs in the Docker image).
# Legacy options google_ai / vertex_ai remain available for KG extraction scripts.
EMBEDDING_PROVIDER=local_bge
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_MODEL=gemini-embedding-001
# VERTEX_PROJECT=your-gcp-project
# VERTEX_LOCATION=us-central1

# Optionally tune embedding dimensions/batching.
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100

# LLM (chat / KG answerer)
LLM_PROVIDER=cerebras
LLM_MODEL=gemma-3-27b-it
CEREBRAS_API_KEY=your-cerebras-api-key-here
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS_TOOL_CALL=512
LLM_MAX_TOKENS_ANSWER=2048

# Video Processing Configuration
YOUTUBE_API_KEY=
SEGMENT_MINUTES=30
OVERLAP_MINUTES=1

# Scraping Configuration
SCRAPE_RATE_LIMIT=1.0
SCRAPE_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)

# Application Configuration
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Retry Configuration
RETRY_MAX_ATTEMPTS=7
RETRY_START_DELAY=10.0
RETRY_DELAY_INCREMENT=1.0
